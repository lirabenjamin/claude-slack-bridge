# Slack bot user OAuth token (OAuth & Permissions page; starts with "xoxb")
SLACK_BOT_TOKEN=paste-your-bot-token-here

# Slack app-level token for Socket Mode (Basic Information page; starts with "xapp")
SLACK_APP_TOKEN=paste-your-app-token-here

# Optional: absolute path to the claude CLI if it is not found automatically.
# CLAUDE_BIN=/path/to/claude

# Optional: fixed token for the Pip web UI. If unset, one is generated into .pip_token.
# PIP_TOKEN=
